NODE_ENV=development
PORT=8787
LOCAL_DEMO_MODE=true
# Separate multiple production origins with |.
ALLOWED_ORIGIN=http://localhost:5173

# Production Google Cloud settings
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=europe-west2
VERTEX_LOCATION=europe-west4
NARRATIVE_PROVIDER=vertex
NARRATIVE_MODEL=gemini-2.5-flash
PLANNING_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004
IMAGE_MODEL=gemini-2.5-flash-image
MODEL_ARMOR_LOCATION=europe-west2
MODEL_ARMOR_TEMPLATE=family-adventure-u12
MEDIA_BUCKET=your-project-id.firebasestorage.app
REQUIRE_APP_CHECK=true
LOG_RETENTION_DAYS=14
TASKS_QUEUE=family-adventure-media
CLOUD_RUN_SERVICE_URL=https://family-adventure-api-000000000000.europe-west2.run.app
TASK_SERVICE_ACCOUNT=family-adventure-api@your-project-id.iam.gserviceaccount.com
